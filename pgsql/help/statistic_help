 SELECT pg_size_pretty(pg_relation_size('pg_catalog.pg_statistic'));

SELECT attname, n_distinct,
    CASE
        WHEN n_distinct > 0 THEN n_distinct
        ELSE round(abs(n_distinct) * c.reltuples)
    END AS estimated_distinct_values
FROM pg_stats s
JOIN pg_class c
    ON c.relname = s.tablename
JOIN pg_namespace n
    ON n.oid = c.relnamespace
   AND n.nspname = s.schemaname
WHERE s.schemaname = 'datamart_humana'
  AND s.tablename = 'claim'
ORDER BY estimated_distinct_values;

