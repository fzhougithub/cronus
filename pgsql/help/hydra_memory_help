WITH parts AS (
  SELECT c.oid::regclass AS rel
  FROM pg_class c
  JOIN pg_namespace n ON c.relnamespace = n.oid
  WHERE n.nspname = 'datamart_humana'
    AND c.relname LIKE 'claim_c_830_%_p%'
)
SELECT
  count(*) AS stripes_scanned,
  SUM(cs.rowcount)   AS total_rows,
  SUM(cs.datalength) AS total_datalength_bytes,
  MAX(cs.rowcount)   AS max_rows_in_any_stripe
FROM parts
CROSS JOIN LATERAL columnar.stats(parts.rel) AS cs;

