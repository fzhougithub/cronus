-- partition table exists, but not be attached to parent. 
SELECT
    n.nspname  AS schema_name,
    c.relname  AS table_name
FROM pg_class c
JOIN pg_namespace n ON n.oid = c.relnamespace
WHERE c.relkind = 'r'        -- 普通表
  AND c.relispartition       -- 被标记为分区
  AND NOT EXISTS (
      SELECT 1
      FROM pg_inherits i
      WHERE i.inhrelid = c.oid
  );



SELECT DISTINCT c.child_table AS child
FROM (
  VALUES
    ('claim_component_block_information'),
    ('claim_extension_1'),
    ('claim_error'),
    ('claim_core'),
    ('error_configuration'),
    ('ncpdp_error_configuration'),
    ('transition_error_override'),
    ('claim_module_flow'),
    ('cip_claims_table_catalog'),
    ('databasechangelog'),
    ('cip_claims_table_catalog_bak')
) AS p(parent_table)
JOIN pg_inherits ON inhparent = p.parent_table::regclass
JOIN LATERAL (SELECT inhrelid::regclass AS child_table) AS c ON true
ORDER BY c.child_table;
