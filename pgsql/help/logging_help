log_line_prefix = '%m [%p] %q%u@%d'

which means:

Token	Meaning%m	Timestamp with milliseconds
%p	PostgreSQL backend PID
%q	Stop processing for non-session processes (background workers)
%u	Database username
%d	Database name

The other two useful fields will be 
%x = transaction ID
%a = application_name
%c = session ID



SELECT pg_read_file(pg_current_logfile()) AS log_content
WHERE pg_read_file(pg_current_logfile()) LIKE '%qc_finance_global_sub%';

# Enhanced logical replication logging
log_min_messages = debug1
log_error_verbosity = verbose
log_logical_rewrite_streaming = on
wal_level = logical

# Specific to logical replication
debug_print_parse = on
debug_print_rewritten = on
debug_print_plan = on


