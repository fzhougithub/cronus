SELECT
    pt.relid::regclass AS partition_name,
    substring(
        pg_get_expr(c.relpartbound,c.oid)
        FROM 'FROM \(''([^'']+)'
    )::date AS start_dt,
    substring(
        pg_get_expr(c.relpartbound,c.oid)
        FROM 'TO \(''([^'']+)'
    )::date AS end_dt
FROM pg_partition_tree('claim_ccg') pt
JOIN pg_class c
  ON c.oid = pt.relid
WHERE not pt.isleaf;
