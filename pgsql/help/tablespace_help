SELECT
    n.nspname,
    c.relname,
    COALESCE(t.spcname,'pg_default')
FROM pg_class c
JOIN pg_namespace n
  ON n.oid=c.relnamespace
LEFT JOIN pg_tablespace t
  ON t.oid=c.reltablespace
WHERE n.nspname='customer'
AND c.relname='w15';

