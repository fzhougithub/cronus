SELECT
    schemaname,
    relname,
    count(*) AS indexes,
    pg_size_pretty(sum(pg_relation_size(indexrelid))) AS index_size
FROM pg_stat_user_indexes
WHERE schemaname LIKE 'finance%'
GROUP BY schemaname, relname
ORDER BY sum(pg_relation_size(indexrelid)) DESC
LIMIT 30;

