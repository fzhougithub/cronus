-- Primary
SELECT
    client_addr AS subscriber_ip,
    application_name AS subscription_name,
    state,
    -- Lag in bytes between what publisher generated vs what was sent
    pg_wal_lsn_diff(pg_current_wal_lsn(), sent_lsn) AS sent_lag_bytes,
    -- Lag in bytes between what publisher generated vs what subscriber wrote to disk
    pg_wal_lsn_diff(pg_current_wal_lsn(), write_lsn) AS write_lag_bytes,
    -- Lag in bytes between what publisher generated vs what subscriber flushed to disk
    pg_wal_lsn_diff(pg_current_wal_lsn(), flush_lsn) AS flush_lag_bytes,
    -- Lag in bytes between what publisher generated vs what subscriber actually applied/replayed
    pg_wal_lsn_diff(pg_current_wal_lsn(), replay_lsn) AS replay_lag_bytes,
    -- Human-readable format of the total replication lag
    pg_size_pretty(pg_wal_lsn_diff(pg_current_wal_lsn(), replay_lsn)) AS readable_replay_lag
FROM pg_stat_replication;

