SELECT
    calls,
    round(total_exec_time::numeric,0) total_ms,
    round(mean_exec_time::numeric,2) avg_ms,
    rows,
    left(query,150)
FROM pg_stat_statements
ORDER BY total_exec_time DESC
LIMIT 20;

SELECT
    calls,
    mean_exec_time,
    rows,
    query
FROM pg_stat_statements
WHERE query LIKE '%pg_stat_user_tables%'
ORDER BY calls DESC;


SELECT
    calls,
    mean_exec_time,
    rows,
    query
FROM pg_stat_statements
WHERE query LIKE '%pg_statio_user_tables%'
ORDER BY calls DESC;

