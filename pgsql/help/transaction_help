SELECT
    calls,
    total_exec_time,
    mean_exec_time,
    rows,
    left(query,120)
FROM pg_stat_statements
ORDER BY calls DESC
LIMIT 20;

SELECT
    xact_commit,
    xact_rollback,
    blks_read,
    blks_hit,
    tup_returned,
    tup_fetched
FROM pg_stat_database
WHERE datname = current_database();

