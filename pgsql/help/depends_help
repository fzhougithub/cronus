WITH RECURSIVE deps AS (
    SELECT
        c.oid,
        c.relname,
        0 AS depth
    FROM pg_class c
    WHERE relkind = 'm'

    UNION ALL

    SELECT
        c.oid,
        c.relname,
        d.depth + 1
    FROM pg_depend dep
    JOIN pg_class c ON dep.objid = c.oid
    JOIN deps d ON dep.refobjid = d.oid
)
SELECT relname, max(depth)
FROM deps
GROUP BY relname
ORDER BY max(depth);
