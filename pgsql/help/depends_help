SELECT
    n.nspname AS schema,
    c.relname AS matview,
    d.refobjid::regclass AS referenced_object
FROM pg_depend d
JOIN pg_class c ON d.objid = c.oid
JOIN pg_namespace n ON c.relnamespace = n.oid
WHERE c.relname = 'mac_pricing_drug_list_entries_vw'
  AND c.relkind = 'm';

