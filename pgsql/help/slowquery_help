AND CE2.CLAIM_ID = CC.CLAIM_ID
LEFT JOIN
	(SELECT CUSTOMER_ID,
			CLAIM_ID,
			SUM(CLAIM_OTHER_AMOUNT_PAID_AMT) AS TOTAL_CLAIM_OTHER_AMOUNT_PAID_AMT
		FROM CLAIM_OTHER_AMOUNT_PAID
		GROUP BY CUSTOMER_ID,
			CLAIM_ID) COAP_SUM ON COAP_SUM.CUSTOMER_ID = CC.CUSTOMER_ID
AND COAP_SUM.CLAIM_ID = CC.CLAIM_ID
LEFT JOIN
	(SELECT CUSTOMER_ID,
			CLAIM_ID,
			SUM(CLAIM_OTHER_AMOUNT_CLAIMED_SUBMITTED_AMT) AS TOTAL_CLAIM_OTHER_AMOUNT_CLAIMED_SUBMITTED_AMT
		FROM CLAIM_OTHER_AMOUNT_CLAIMED_SUBMITTED
		GROUP BY CUSTOMER_ID,
			CLAIM_ID) COACS_SUM ON COACS_SUM.CUSTOMER_ID = CC.CUSTOMER_ID
AND COACS_SUM.CLAIM_ID = CC.CLAIM_ID
LEFT JOIN GLOBAL.X80 X80 ON X80.NDC_ID = CC.NDC_ID
