select sum(total_size_bytes) from (SELECT
    c.relname AS partition_name,
    am.amname AS access_method,           -- should show 'columnar' or similar
    pg_total_relation_size(c.oid) AS total_size,
    pg_total_relation_size(c.oid) AS total_size_bytes,
    c.reltuples::bigint AS estimated_rows,
    p.parent_relname AS parent_table
FROM pg_class c
JOIN pg_namespace n ON n.oid = c.relnamespace
LEFT JOIN pg_am am ON am.oid = c.relam
LEFT JOIN (
    SELECT inhrelid AS child_oid,
           parent.relname AS parent_relname
    FROM pg_inherits inh
    JOIN pg_class parent ON parent.oid = inh.inhparent
) p ON p.child_oid = c.oid
WHERE c.relkind = 'r'                    -- ordinary table
  AND c.relispartition = true            -- is a partition
  AND c.relname LIKE 'claim_ccg%'        -- your prefix
  AND am.amname IN ('columnar', 'cstore') -- adjust if your columnar AM has different name
ORDER BY pg_total_relation_size(c.oid) DESC);
