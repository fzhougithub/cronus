SELECT
    child.oid::regclass AS partition_name,
    pg_size_pretty(pg_total_relation_size(child.oid)) AS total_size,
    pg_size_pretty(pg_relation_size(child.oid)) AS table_size,
    pg_size_pretty(pg_total_relation_size(child.oid) - pg_relation_size(child.oid)) AS index_size
FROM
    pg_inherits
JOIN
    pg_class child ON pg_inherits.inhrelid = child.oid
JOIN
    pg_class parent ON pg_inherits.inhparent = parent.oid
JOIN
    pg_namespace nsp ON parent.relnamespace = nsp.oid
WHERE
    parent.relname = 'a_claim_core'
    AND nsp.nspname = 'claimsprocess'
ORDER BY
    pg_total_relation_size(child.oid) DESC;

