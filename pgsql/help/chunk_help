SELECT
    storage_id,
    stripe_num,
    chunk_group_num,
    SUM(value_decompressed_length)/1024/1024/1024 AS total_decompressed
FROM columnar.chunk
GROUP BY
    storage_id,
    stripe_num,
    chunk_group_num
ORDER BY
    total_decompressed DESC;


