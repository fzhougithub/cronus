grep -RFl "value: '%m [%p] %q%u@%d '" reporting_analysis-prod | while read -r file
do
    sed -i "s|value: '%m \[%p\] %q%u@%d '|value: '%m [%p] %q%u@%d txid=%x sess=%c '|g" "$file"
done

