psql -d ods_domani -Atc "
    WITH RECURSIVE parts AS (
        SELECT c.oid, n.nspname, c.relname
        FROM pg_class c
        JOIN pg_namespace n ON n.oid = c.relnamespace
        WHERE c.oid = 'datamart_humana.claim'::regclass

        UNION ALL

        SELECT c.oid, n.nspname, c.relname
        FROM pg_inherits i
        JOIN pg_class c ON c.oid = i.inhrelid
        JOIN pg_namespace n ON n.oid = c.relnamespace
        JOIN parts p ON p.oid = i.inhparent
    )
    SELECT '-t ' || quote_ident(nspname)||'.'||quote_ident(relname)
    FROM parts
    WHERE NOT EXISTS (
        SELECT 1 FROM pg_inherits i WHERE i.inhparent = parts.oid
    );
  "

pg_dump -Fd -j 10 -d ods_domani -f /pg_backups/datamart_humana_claim \
$(<above large table query)


