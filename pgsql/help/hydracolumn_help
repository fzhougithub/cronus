SELECT
    a.attname,
    x.*
FROM (
    SELECT
        attr_num,
        count(*) AS chunks,
        count(minimum_value) AS non_null_chunks,
        count(distinct (minimum_value,maximum_value)) AS range_count
    FROM columnar.chunk
    GROUP BY attr_num
) x
JOIN pg_attribute a
  ON a.attrelid =
     'datamart_humana.claim_320_2026'::regclass
 AND a.attnum = x.attr_num
ORDER BY range_count;

SELECT
    attr_num,
    count(*)                                        AS chunks,
    count(minimum_value)                            AS non_null_chunks,
    count(distinct (minimum_value,maximum_value))   AS range_count,
    sum(value_count)                                AS rows
FROM columnar.chunk
GROUP BY attr_num
ORDER BY range_count;

