SELECT 
    t.tablename, 
    s.tablespacename 
FROM pg_tables t
LEFT JOIN pg_tablespaces s ON t.tablespace = s.tablespacename
WHERE schemaname = 'claimsprocess_humana' 
  AND tablename = 'claim_core_320_202604';

