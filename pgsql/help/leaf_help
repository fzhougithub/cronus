SELECT
    n.nspname AS schema_name,
    c.relname AS leaf_partition,
    pg_get_expr(c.relpartbound, c.oid) AS partition_bound
FROM pg_class c
JOIN pg_namespace n ON n.oid = c.relnamespace
WHERE c.relispartition = true
  AND NOT EXISTS (
      SELECT 1
      FROM pg_class c2
      WHERE c2.relispartition = true
        AND c2.relpartbound IS NOT NULL
        AND pg_get_expr(c2.relpartbound, c2.oid)
            LIKE '%' || c.relname || '%'
  )
ORDER BY schema_name, leaf_partition;



SELECT n.nspname||'.'||c.relname
FROM pg_class c
JOIN pg_namespace n ON n.oid = c.relnamespace
WHERE n.nspname = 'claimsprocess_humana'
  AND c.relkind = 'r'  -- regular tables
  AND c.oid IN (SELECT inhrelid FROM pg_inherits)  -- is a child
  AND NOT EXISTS (
      SELECT 1 FROM pg_inherits WHERE inhparent = c.oid
  )  -- not a parent
ORDER BY pg_total_relation_size(c.oid) DESC;


SELECT n.nspname AS schema_name,
       c.relname AS table_name,
       pg_total_relation_size(c.oid) AS total_size_bytes
FROM pg_class c
JOIN pg_namespace n ON n.oid = c.relnamespace
WHERE n.nspname = 'claimsprocess_humana'
  AND c.relkind = 'r'  -- regular tables
  AND c.oid IN (SELECT inhrelid FROM pg_inherits)  -- is a child
  AND NOT EXISTS (
      SELECT 1 FROM pg_inherits WHERE inhparent = c.oid
  )  -- not a parent
ORDER BY pg_total_relation_size(c.oid) DESC;


SELECT inhparent::regclass AS parent_table
FROM pg_inherits
WHERE inhrelid = 'claimsprocess_humana.claim_submission_clarification_codes_63'::regclass;

