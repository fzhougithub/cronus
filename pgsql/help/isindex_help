SELECT format(
  'CREATE INDEX ON %I.%I (customer_id, claim_id);',
  n.nspname,
  c.relname
)
FROM pg_class c
JOIN pg_namespace n ON n.oid = c.relnamespace
WHERE c.oid IN (
  SELECT inhrelid
  FROM pg_inherits
  WHERE inhparent = 'claimsprocess_humana.a_claim_core'::regclass
);"


SELECT
  format(
    'CREATE INDEX ON %I.%I (customer_id, claim_id);',
    n.nspname,
    c.relname
  )
FROM pg_class c
JOIN pg_namespace n ON n.oid = c.relnamespace
WHERE c.relispartition
  AND c.relnamespace = 'claimsprocess_humana'::regnamespace
  AND c.relname LIKE 'a_claim_core_%_%';

