SELECT
    inhrelid::regclass AS partition,
    EXISTS (
        SELECT 1
        FROM pg_index i
        JOIN pg_class c ON c.oid = i.indexrelid
        WHERE i.indrelid = inhrelid
          AND c.relname = 'a_claim_core_ix1'
    ) AS has_index
FROM pg_inherits
WHERE inhparent = 'claimsprocess_humana.a_claim_core'::regclass;

