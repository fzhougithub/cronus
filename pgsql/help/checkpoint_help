SELECT
    checkpoints_timed,          -- 由 checkpoint_timeout 参数触发的检查点数量
    checkpoints_req,           -- 强制触发的检查点数量（例如运行 CHECKPOINT 命令）
    checkpoint_write_time,     -- 检查点期间写入数据到磁盘所花费的总时间（毫秒）
    checkpoint_sync_time,      -- 检查点期间将文件同步到磁盘所花费的总时间（毫秒）
    buffers_checkpoint,        -- 检查点写入的缓冲区数量
    buffers_alloc              -- 总的已分配缓冲区数量
FROM pg_stat_bgwriter;
