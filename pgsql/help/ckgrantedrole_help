  pg_has_role('ppdreporting', 'pg_monitor', 'member')         AS ppd_monitor,
  pg_has_role('datamart', 'pg_read_all_stats', 'member')      AS dm_member,
  pg_has_role('datamart', 'pg_monitor', 'member')             AS dm_monitor;
