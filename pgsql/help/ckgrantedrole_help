ods_domani=# SELECT
  m.rolname AS member_role,
  r.rolname AS granted_role
FROM pg_catalog.pg_auth_members pam
JOIN pg_catalog.pg_roles m ON m.oid = pam.member
JOIN pg_catalog.pg_roles r ON r.oid = pam.roleid
WHERE m.rolname IN ('ppdreporting', 'datamart', 'postgres')
   OR r.rolname IN ('pg_read_all_stats', 'pg_monitor')
ORDER BY 1, 2;


