    n.nspname AS schema_name,
    has_schema_privilege('ab_claimsprocess_humana', n.nspname, 'USAGE') AS has_usage,
    has_schema_privilege('ab_claimsprocess_humana', n.nspname, 'CREATE') AS has_create
