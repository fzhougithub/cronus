SELECT subname, pid,
    -- If NULL, the worker has crashed or is disabled
    CASE WHEN pid IS NULL THEN 'STOPPED/ERROR' ELSE 'RUNNING' END as status,
    -- Time since the last message was received from the publisher
    now() - last_msg_receipt_time AS replication_lag,
    -- Processing gap: Time between publisher sending and subscriber receiving
    last_msg_receipt_time - last_msg_send_time AS transport_delay, received_lsn, latest_end_lsn,
    -- Flag problematic lag (e.g., more than 60 seconds)
    CASE
        WHEN (now() - last_msg_receipt_time) > interval '60 seconds' THEN (now() - last_msg_receipt_time)::text
        WHEN pid IS NULL THEN 'CRITICAL: WORKER DOWN'
        ELSE 'HEALTHY'
    END as health_check
FROM pg_stat_subscription;

