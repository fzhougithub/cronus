SELECT n.nspname AS schema_name,
       c.relname AS sequence_name,
       c.relacl
FROM pg_class c
JOIN pg_namespace n
  ON n.oid = c.relnamespace
WHERE c.relkind = 'S'
  AND c.relname = 'batch_job_instance_seq';
   schema_name   |     sequence_name      |                                        relacl
-----------------+------------------------+--------------------------------------------------------------------------------------
 drugmgmt        | batch_job_instance_seq | {postgres=rwU/postgres,drugmgmt_ro=r/postgres,drugmgmt_rw=rwU/postgres}
 program_mandate | batch_job_instance_seq | {postgres=rwU/postgres,program_mandate_ro=r/postgres,program_mandate_rw=rw/postgres}
 planconfig      | batch_job_instance_seq | {postgres=rwU/postgres,planconfig_rw=rw/postgres,planconfig_ro=r/postgres}
 lists           | batch_job_instance_seq | {postgres=rwU/postgres,lists_ro=r/postgres,lists_rw=rw/postgres}
(4 rows)

SELECT n.nspname, c.relname, grantee.rolname AS grantee, privilege_type
FROM pg_class c
JOIN pg_namespace n
    ON n.oid = c.relnamespace
CROSS JOIN LATERAL aclexplode(coalesce(c.relacl, acldefault('s', c.relowner))) a
JOIN pg_roles grantee
    ON grantee.oid = a.grantee
WHERE c.relkind = 'S'
  AND c.relname = 'batch_job_instance_seq';

