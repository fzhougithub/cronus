SELECT
    r.rolname AS role_name,
    u.rolname AS member_name
FROM pg_auth_members m
JOIN pg_roles r ON r.oid = m.roleid
JOIN pg_roles u ON u.oid = m.member
WHERE r.rolname = 'ai_rw' and u.rolname='sitdomaniai';
 role_name | member_name
-----------+-------------
 ai_rw     | sitdomaniai
(1 row)



SELECT
    m.rolname AS member_name
FROM
    pg_auth_members am
JOIN
    pg_roles m ON m.oid = am.member
JOIN
    pg_roles g ON g.oid = am.roleid
WHERE
    g.rolname = 'finance_other_rw';
