SELECT n.nspname || '.' || c.relname AS table_name
FROM pg_class c
JOIN pg_namespace n ON c.relnamespace = n.oid
LEFT JOIN pg_publication_tables ppt
  ON ppt.schemaname = n.nspname
 AND ppt.tablename = c.relname
WHERE c.relkind = 'r'                           -- ordinary tables only
  AND n.nspname = 'claimsprocess_other'          -- your schema
  AND ppt.tablename IS NULL                     -- not in any publication
ORDER BY c.relname;

