# ~/.zshrc

# History configuration
export HISTSIZE=10000
export SAVEHIST=10000
# Zsh options
setopt APPEND_HISTORY             # Append commands to the history file
setopt INC_APPEND_HISTORY         # Immediately append every command
setopt HIST_IGNORE_ALL_DUPS       # Avoid duplicates
setopt HIST_REDUCE_BLANKS
setopt SHARE_HISTORY              # Share history between open sessions

# Restore key bindings if needed
bindkey "^[[A" up-line-or-history
bindkey "^[[B" down-line-or-history

# Custom alias for full history
real_history() {
strings ~/.zsh_sessions/history_* 2>/dev/null \
  | sed 's/^: [0-9]*:[0-9]*;//' \
  | sort -u \
  | nl
}
gpobf() {
  git push origin "$(git branch | grep '*' | cut -d' ' -f2)" -f
}
alias rhistory='real_history'
alias cn='cat ~/*nodes'
alias pn='cat ~/nodespgpool'
alias cw='cat ~/.pgpass'
alias gcam='git commit --amend --no-edit'
alias gcam='git commit --amend -m "Your New Commit Title"'
alias gb='git branch'
alias gpomr='git pull origin main --rebase'
alias gsa='git stash -a'
alias gsp='git stash pop'
alias gsl='git stash list'
alias gssp='git stash show -p stash@{1}'


