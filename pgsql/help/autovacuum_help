DO $$
DECLARE
    row record;
BEGIN
    FOR row IN 
        SELECT st.schemaname, st.relname
        FROM pg_stat_user_tables st
        JOIN pg_class c ON st.relid = c.oid
        WHERE ((pg_total_relation_size(c.oid) > 10 * 1024^3) -- Larger than 10GB
           OR (st.n_live_tup > 5000000))                   -- More than 5M live tuples
           AND st.last_autovacuum IS NULL
    LOOP
        EXECUTE format('ALTER TABLE %I.%I SET (
            autovacuum_vacuum_scale_factor = 0.002,
            autovacuum_vacuum_threshold = 50,
            autovacuum_analyze_scale_factor = 0.001,
            autovacuum_analyze_threshold = 50,
            autovacuum_vacuum_cost_limit = 1000,
            autovacuum_vacuum_cost_delay = 10
        )', row.schemaname, row.relname);
        
        RAISE NOTICE 'Applied autovacuum settings to %.%', row.schemaname, row.relname;
    END LOOP;
END $$;

