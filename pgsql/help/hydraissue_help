SELECT
  pid,
  COUNT(*) FILTER (WHERE amname = 'columnar') AS columnar_tables,
  COUNT(*) FILTER (WHERE amname = 'heap') AS heap_tables,
  COUNT(*) AS total
FROM (
  SELECT
    l.pid,
    am.amname
  FROM pg_locks l
  JOIN pg_class c ON l.relation = c.oid
  LEFT JOIN pg_am am ON c.relam = am.oid
  WHERE l.locktype = 'relation'
) t
GROUP BY pid
ORDER BY total DESC;


SELECT
  pid,
  tables,
  array_agg(relname) AS columnar_samples
FROM (
  SELECT
    a.pid,
    COUNT(*) OVER (PARTITION BY a.pid) AS tables,
    c.relname,
    ROW_NUMBER() OVER (PARTITION BY a.pid ORDER BY c.relname) AS rn
  FROM pg_stat_activity a
  JOIN pg_locks l ON a.pid = l.pid
  JOIN pg_class c ON l.relation = c.oid
  JOIN pg_am am ON c.relam = am.oid
  WHERE l.locktype = 'relation'
    AND am.amname = 'columnar'
) t
WHERE rn <= 5
GROUP BY pid, tables
ORDER BY tables DESC;

