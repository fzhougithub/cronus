[Unit]
Description=pgDog Database Proxy
Documentation=https://pgdog.dev
After=network.target
Wants=network.target

[Service]
Type=simple
User=postgres
Group=postgres
Environment="RUST_LOG=debug"
ExecStart=/usr/bin/pgdog -c /etc/pgdog/pgdog.toml -u /etc/pgdog/users.toml run
ExecReload=/bin/kill -HUP $MAINPID
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30
Restart=always
RestartSec=5

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/pgdog /var/lib/pgdog
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE

# Resource limits
LimitNOFILE=65536
MemoryMax=1G

# Logging
StandardOutput=append:/var/log/pgdog/pgdog.log
StandardError=append:/var/log/pgdog/pgdog.log

[Install]
WantedBy=multi-user.target
