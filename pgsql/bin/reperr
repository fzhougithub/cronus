#!/bin/bash

greplist='A'
if [ $# -eq 1 ];then
	greplist=$1
fi

logfile=$(ls -larth /pg_logs/postgresql-*|tail -1|awk '{print $9}')

PIDs=$(grep PID $logfile|awk '{print $12}'|cut -d')' -f1|egrep -v "$greplist"|tail -10)
for i in $PIDs; do echo ; echo $i;echo ------- ; grep $i $logfile;done

echo $logfile
echo DB_time $(psql -At -c 'select now()')
echo OS_time $(date '+%Y-%m-%d %H:%M:%S.%6N%:::z')
