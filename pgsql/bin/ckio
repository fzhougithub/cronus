#!/bin/bash

INTERVAL=1
COUNT=10

if [[ $# -lt 2 ]]; then
    echo "Usage:"
    echo "  $0 <dbname> <util_threshold> [aqusz_threshold]"
    echo
    echo "Example:"
    echo "  $0 ods_domani 60 10"
    exit 1
fi

DBNAME="$1"
UTIL_THRESHOLD="$2"
AQSZ_THRESHOLD="${3:-10}"

TMP="/tmp/ckio.$$"
DEVFILE="/tmp/ckio.devices.$$"

rm -f "$DEVFILE"

echo "Collecting disk statistics..."

iostat -dx "$INTERVAL" "$COUNT" > "$TMP"

echo
echo "Devices exceeding:"
echo "  util  > ${UTIL_THRESHOLD}%"
echo "  aqu-sz > ${AQSZ_THRESHOLD}"
echo

awk \
-v util_limit="$UTIL_THRESHOLD" \
-v aqu_limit="$AQSZ_THRESHOLD" \
-v devfile="$DEVFILE" '
BEGIN {
    header=0
}

/^(sd|dm)/ {

    dev=$1

    rps=$2
    rkbs=$3

    wps=$8
    wkbs=$9

    rawait=$6
    wawait=$12

    await=(rawait+wawait)/2

    aqusz=$22
    util=$23

    if (util > util_limit || aqusz > aqu_limit) {

        if (header == 0) {

            printf "%-10s %8s %8s %12s %12s %8s %8s %8s\n",
                   "Device",
                   "r/s",
                   "w/s",
                   "rkB/s",
                   "wkB/s",
                   "await",
                   "aqu-sz",
                   "%util"

            header=1
        }

        printf "%-10s %8.1f %8.1f %12.1f %12.1f %8.2f %8.2f %8.2f\n",
               dev,
               rps,
               wps,
               rkbs,
               wkbs,
               await,
               aqusz,
               util

        print dev >> devfile
    }
}
' "$TMP"

echo
echo "============================================================"
echo "Device Mapping"
echo "============================================================"

if [[ -s "$DEVFILE" ]]; then

    sort -u "$DEVFILE" | while read dev
    do
        echo
        echo "Device: $dev"

        lsblk -p -o NAME,PKNAME,FSTYPE,SIZE,MOUNTPOINT "/dev/$dev"
    done

else
    echo "No matching devices found."
fi

echo
echo "============================================================"
echo "PostgreSQL sessions waiting on IO"
echo "============================================================"

psql -P pager=off -d "$DBNAME" <<'SQL'

SELECT
    pid,
    usename,
    backend_type,
    state,
    wait_event_type,
    wait_event,
    EXTRACT(epoch FROM (now()-query_start))::int AS runtime_sec,
    left(query,200) AS query
FROM pg_stat_activity
WHERE wait_event_type='IO'
ORDER BY runtime_sec DESC;

SQL

echo
echo "============================================================"
echo "DataFileRead Sessions"
echo "============================================================"

psql -P pager=off -d "$DBNAME" <<'SQL'

SELECT
    pid,
    usename,
    backend_type,
    EXTRACT(epoch FROM (now()-query_start))::int AS runtime_sec,
    left(query,200)
FROM pg_stat_activity
WHERE wait_event='DataFileRead'
ORDER BY runtime_sec DESC;

SQL

echo
echo "============================================================"
echo "WAL Replay"
echo "============================================================"

psql -P pager=off -d "$DBNAME" <<'SQL'

SELECT
    pg_is_in_recovery() AS standby,
    pg_size_pretty(
        pg_wal_lsn_diff(
            pg_last_wal_receive_lsn(),
            pg_last_wal_replay_lsn()
        )
    ) AS replay_gap,
    now() - pg_last_xact_replay_timestamp() AS replay_delay;

SQL

rm -f "$TMP" "$DEVFILE"
