#!/bin/bash

CK=${1:-6}
ps -eo pid,ppid,%cpu,%mem --sort=-%cpu |head -$CK
pids=$(ps -eo pid,%cpu,%mem --sort=-%cpu|egrep -v "PID|grep"|head -$CK|awk '{print $1}'|paste -sd, -)
pidstr=$(echo $pids|sed 's/,/|/g')
#echo $pids
#echo $pidstr
echo "-----------------"
ps -ef|egrep "$pidstr"
echo "-----------------"
psql -c "select pid,now()-xact_start,substr(query,1,80) from pg_stat_activity where pid in ($pids)"
