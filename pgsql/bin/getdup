#!/bin/bash

if [ $# -ne 1 ]; then
    echo "Usage: $0 errorfile"
    echo "e.g: $0 /var/tmp/ckrep.log"
    exit 1
else
    tmpfile=/var/tmp/duptemp.log
fi


awk '
{
    if (match($0, /subscription "([^"]+)"/, s))
        subname = s[1]
}

/ERROR:.*duplicate key value violates unique constraint/ {

    while (getline > 0) {

        if (match($0, /CONTEXT:[[:space:]]+COPY ([^, ]+)/, t)) {
            printf "%s %s\n", subname, t[1]
            break
        }

        if ($0 ~ /^ERROR:/)
            break
    }
}
' "$1" > $tmpfile

sed -E 's/^[^_]*_//; s/_sub /\./' $tmpfile

