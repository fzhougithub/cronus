#!/bin/sh

\o 60.list
select tablename,pub_size,sub_size,(pub_size-sub_size)*100/pub_size from chk_count.lr_size_tmp where (pub_size-sub_size)*100/pub_size > 60 and pub_size <>0 order by 2 desc;
\o

echo > 60_import.sql;export s=claimsprocess_humana;for i in $(cat 60.list|cut -d'|' -f1);do t=$(echo $i|cut -d'.' -f2);echo "import foreign schema claimsprocess_humana limit to ($t) FROM SERVER claimshumana_02 into claimsprocess_humana_02;" >> 60_import.sql;done

echo > 60_insert.sh;export s=claimsprocess_humana;for i in $(cat 60.list|cut -d'|' -f1);do t=$(echo $i|cut -d'.' -f2);echo "psql -d ods_domani -v ON_ERROR_STOP=1 -c 'SET fdw_tuple_limit = 100000;insert into $i select * from claimsprocess_humana_02.$t'" >> 60_insert.sh;done

echo > 60_truncate.sql;export s=claimsprocess_humana;for i in $(cat 60.list|cut -d'|' -f1);do echo "truncate table $i restart identity cascade;" >> 60_truncate.sql;done

cat 60_insert.sh | parallel -j 10 --joblog=60_insert.log --results=60_insert_results --eta --progress --line-buffer --keep-order 2>&1 | tee 60_insert_master.log  

ods_domani=# SELECT postgres_fdw_disconnect('claimshumana_02');
 postgres_fdw_disconnect
-------------------------
 f
(1 row)

select 'select pg_terminate_backend('||pid||');' from pg_stat_activity where query like 'insert%claimsprocess_humana_02%' and state='active';

 \! ps -o pid,ppid,state,pcpu,cmd -p 260578
in source: 
SELECT pg_terminate_backend(pid)
FROM pg_stat_activity 
WHERE application_name = 'postgres_fdw' 
  AND datname = 'claimsprocess';

watch -n 10 'ps -eo pid,ppid,state,pcpu,cmd | grep 260578'

  988  /usr/pgsql-16/bin/pg_ctl -D /apps/lib/pgsql/16/data stop -m fast
  990  /usr/pgsql-16/bin/pg_ctl -D /apps/lib/pgsql/16/data stop -m fast -w
  992  /usr/pgsql-16/bin/pg_ctl -D /apps/lib/pgsql/16/data stop -m immediate -w


ods_domani=# ALTER SERVER claimshumana_02  OPTIONS (SET fetch_size '50000');
ALTER SERVER

-- Session-level protection
SET statement_timeout = '10min';
SET fdw_tuple_limit = 100000;

