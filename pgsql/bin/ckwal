#!/bin/bash

if [ $# -ne 1 ]; then
	echo "Usage: $0 version"
	echo "e.g: $0 14"
	exit 1
fi

path=/apps/lib/pgsql/$1/data/pg_wal
tmpfile=/var/tmp/walhistory
ls -larth $path/ > $tmpfile

awk '
{
    if ($6 ~ /^[A-Z][a-z][a-z]$/ && $8 ~ /^[0-9]{2}:[0-9]{2}$/) {
        split($8,t,":")
        bucket=sprintf("%s %s %02d:%02d",
                       $6, $7, t[1], int(t[2]/10)*10)
        count[bucket]++
    }
}
END {
    for (b in count)
        print b, count[b]
}' $tmpfile | sort


echo
echo "WAL volume by 10-minute interval"
echo "================================"

find "$path" -maxdepth 1 -type f \
| awk -F/ '
{
    file=$NF
    if (file ~ /^[0-9A-F]{24}$/) {
        cmd="stat -c %y \"" $0 "\""
        cmd | getline ts
        close(cmd)

        split(ts,a," ")
        split(a[2],t,":")
        bucket=sprintf("%02d:%02d",t[1],int(t[2]/10)*10)

        cnt[bucket]++
    }
}
END {
    for (b in cnt)
        printf "%s  %4d files  %.1f GB\n",
               b,cnt[b],cnt[b]*16/1024
}' | sort
